<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/genealogy_primary</item>
        <item name="colorSecondary">@color/genealogy_secondary</item>
        <item name="android:statusBarColor">@color/genealogy_background</item>
        <item name="android:windowBackground">@color/genealogy_background</item>
    </style>

    <style name="Theme.Genealogy" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/genealogy_primary</item>
        <item name="colorSecondary">@color/genealogy_secondary</item>
        <item name="android:statusBarColor">@color/genealogy_background</item>
        <item name="android:windowBackground">@color/genealogy_background</item>
    </style>

    <style name="Theme.Genealogy.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_genealogy_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/transparent_icon</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.Genealogy</item>
    </style>
</resources>
